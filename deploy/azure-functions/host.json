{
  "version": "2.0",
  "extensions": {
    "http": {
      "routePrefix": ""
    }
  },
  "customHandler": {
    "description": {
      "defaultExecutablePath": "OCID.Api",
      "arguments": [
        "--urls",
        "http://127.0.0.1:%FUNCTIONS_CUSTOMHANDLER_PORT%"
      ]
    },
    "enableForwardingHttpRequest": true
  },
  "logging": {
    "logLevel": {
      "default": "Information"
    }
  }
}

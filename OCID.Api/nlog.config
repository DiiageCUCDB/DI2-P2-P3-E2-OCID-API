<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogToConsole="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variables>
    <!-- Override with the NLOG_LOG_DIR environment variable (e.g. a mounted volume in Docker). -->
    <variable name="logDir" value="${environment:NLOG_LOG_DIR:whenEmpty=${basedir}/logs}" />
  </variables>

  <targets async="true">
    <!-- Human readable, for docker logs / dotnet run -->
    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${aspnet-TraceIdentifier}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

    <!-- Structured JSON, one object per line, rolled daily and every 10 MB, 14 days kept -->
    <target xsi:type="File" name="file"
            fileName="${logDir}/ocid-${shortdate}.log"
            archiveFileName="${logDir}/archive/ocid-{#}.log"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            maxArchiveFiles="14"
            keepFileOpen="true"
            encoding="utf-8">
      <layout xsi:type="JsonLayout" includeEventProperties="true">
        <attribute name="time" layout="${date:format=o}" />
        <attribute name="level" layout="${level:uppercase=true}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
        <attribute name="traceId" layout="${aspnet-TraceIdentifier}" />
        <attribute name="environment" layout="${environment:ASPNETCORE_ENVIRONMENT}" />
      </layout>
    </target>
  </targets>

  <rules>
    <!-- Framework noise: keep Warning and above only -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Everything else (OCID.*) from Information up -->
    <logger name="*" minlevel="Info" writeTo="console" />
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
